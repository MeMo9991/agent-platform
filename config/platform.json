{
  "projectGroups": [
    {
      "projectKey": "agent-platform",
      "verification": true,
      "repositories": [
        {
          "repoKey": "agent-platform",
          "provider": "github",
          "hostUrl": "https://github.com",
          "projectRef": "MeMo9991/agent-platform",
          "targetBranch": "main",
          "requiredChecks": [
            "verify"
          ],
          "autoPr": {
            "enabled": true,
            "allowedPrefixes": [
              "src/",
              "tests/",
              "web/src/"
            ]
          },
          "credentialsRef": "env:AGENT_PLATFORM_GITHUB_TOKEN",
          "localPath": "."
        }
      ]
    },
    {
      "projectKey": "devops-project-cloudbom",
      "verification": false,
      "repositories": []
    }
  ],
  "agents": [
    {
      "kind": "qoder",
      "enabled": true
    }
  ],
  "interaction": {
    "actorId": "local-owner",
    "roles": [
      "answer",
      "route",
      "approve",
      "reopen",
      "submit",
      "command",
      "configure"
    ],
    "credentialFile": "~/.config/agent-platform/local-api.token",
    "port": 8765
  },
  "budget": {
    "maxRunMs": 600000,
    "maxConcurrentRuns": 2,
    "perRepoConcurrentRuns": 2,
    "perAgentConcurrentRuns": 2,
    "reservedHumanResume": 1
  },
  "policyRef": "default",
  "cache": {
    "root": ".runtime/caches"
  }
}
