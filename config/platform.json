{
  "repositories": [
    {
      "repoKey": "agent-platform",
      "provider": "github",
      "hostUrl": "https://github.com",
      "projectRef": "MeMo9991/agent-platform",
      "targetBranch": "main",
      "requiredChecks": ["verify"],
      "localChecks": [
        { "command": "npm", "args": ["run", "typecheck"], "timeoutMs": 120000 },
        { "command": "npm", "args": ["test"], "timeoutMs": 180000 }
      ],
      "credentialsRef": "env:AGENT_PLATFORM_GITHUB_TOKEN",
      "localPath": "."
    }
  ],
  "sources": [
    {
      "id": "devops-assigned",
      "kind": "devops-defect",
      "configRef": "devops-assigned-defects",
      "enabled": true
    }
  ],
  "agents": [{ "kind": "qoder", "enabled": true }],
  "interaction": {
    "actorId": "local-owner",
    "roles": ["answer", "route", "approve", "reopen", "submit", "command", "configure"],
    "credentialFile": "~/.config/agent-platform/local-api.token",
    "port": 8765
  },
  "budget": {
    "maxRunMs": 600000,
    "maxConcurrentRuns": 2,
    "perRepoConcurrentRuns": 2,
    "perAgentConcurrentRuns": 2,
    "reservedHumanResume": 1
  },
  "policyRef": "default"
}
